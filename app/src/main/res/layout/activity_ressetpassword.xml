<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B3A8F"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="26sp" />

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:contentDescription="STUDEX logo"
            android:src="@drawable/studex_logo_cutout" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STUDE"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="X"
                android:textColor="#FF3B30"
                android:textSize="30sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Where Students Connect"
            android:textColor="#CFDBFF"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Set New Password"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Your new password must be at least 8 characters and include a number and a letter."
            android:textColor="#CFDBFF" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <EditText
                android:id="@+id/etNewPass"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="#FFFFFF"
                android:drawablePadding="12dp"
                android:drawableStart="@android:drawable/ic_lock_idle_lock"
                android:drawableTint="#1E4FD8"
                android:hint="New Password"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="70dp"
                android:textColor="#0B2A6F"
                android:textColorHint="#98A2B3" />
            <TextView
                android:id="@+id/tvShowNew"
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:layout_gravity="end"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:text="SHOW"
                android:textColor="#1E4FD8"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <EditText
                android:id="@+id/etConfirmPass"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="#FFFFFF"
                android:drawablePadding="12dp"
                android:drawableStart="@android:drawable/ic_lock_idle_lock"
                android:drawableTint="#1E4FD8"
                android:hint="Confirm New Password"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="70dp"
                android:textColor="#0B2A6F"
                android:textColorHint="#98A2B3" />
            <TextView
                android:id="@+id/tvShowConfirm"
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:layout_gravity="end"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:text="SHOW"
                android:textColor="#1E4FD8"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>

        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:backgroundTint="#FFFFFF"
            android:text="Reset Password"
            android:textColor="#0B3A8F"
            android:textStyle="bold" />

        <!-- Hidden until the password is reset -->
        <LinearLayout
            android:id="@+id/bannerSuccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#E8F5E9"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓  Password reset successfully!"
                android:textColor="#2E7D32"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="You can now sign in with your new password."
                android:textColor="#2E7D32"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>